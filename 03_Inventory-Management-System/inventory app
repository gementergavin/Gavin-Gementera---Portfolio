#!/usr/bin/env python3
"""
Inventory Management System - CLI Application
Professional Business Process Prototype for Training & Event Resource Management

Run: python inventory_app.py
"""

import sqlite3
import sys
from datetime import datetime
from pathlib import Path

DB_PATH = Path(__file__).parent / "inventory_management.db"

def get_connection():
    return sqlite3.connect(DB_PATH)

def show_low_stock_report():
    """Generate low stock / reorder report"""
    conn = get_connection()
    cursor = conn.cursor()
    
    print("\n" + "="*80)
    print("LOW STOCK / REORDER ALERT REPORT")
    print("="*80)
    
    cursor.execute("""
        SELECT 
            i.sku,
            i.item_name,
            c.category_name,
            l.location_name,
            inv.quantity_on_hand,
            i.reorder_level,
            (i.reorder_level - inv.quantity_on_hand) as shortage
        FROM inventory inv
        JOIN items i ON inv.item_id = i.item_id
        JOIN categories c ON i.category_id = c.category_id
        JOIN locations l ON inv.location_id = l.location_id
        WHERE inv.quantity_on_hand < i.reorder_level
        ORDER BY shortage DESC, l.location_name
    """)
    
    rows = cursor.fetchall()
    
    if not rows:
        print("No items currently below reorder level. All good!")
        return
    
    print(f"{'SKU':<12} {'Item Name':<40} {'Location':<25} {'On Hand':>8} {'Reorder Lvl':>10} {'Short':>6}")
    print("-" * 105)
    
    for row in rows:
        print(f"{row[0]:<12} {row[1][:38]:<40} {row[3][:23]:<25} {row[4]:>8} {row[5]:>10} {row[6]:>6}")
    
    print(f"\nTotal items needing attention: {len(rows)}")
    conn.close()

def record_transaction():
    """Simple transaction recording (Receipt or Fulfillment)"""
    print("\n--- Record New Transaction ---")
    print("1. Receipt (add stock)")
    print("2. Fulfillment (remove stock for training/event)")
    print("3. Adjustment (correction)")
    
    choice = input("Select transaction type (1-3): ").strip()
    
    t_map = {"1": "RECEIPT", "2": "FULFILLMENT", "3": "ADJUSTMENT"}
    t_type = t_map.get(choice)
    
    if not t_type:
        print("Invalid choice.")
        return
    
    sku = input("Enter SKU: ").strip().upper()
    qty = int(input("Enter quantity: "))
    performed_by = input("Performed by (your name): ").strip() or "Unknown User"
    notes = input("Notes / Reference (optional): ").strip()
    
    conn = get_connection()
    cursor = conn.cursor()
    
    # Find item
    cursor.execute("SELECT item_id FROM items WHERE sku = ?", (sku,))
    item = cursor.fetchone()
    if not item:
        print(f"SKU {sku} not found.")
        conn.close()
        return
    
    item_id = item[0]
    
    # Simple location assumption for demo (San Diego Main)
    location_id = 1
    
    if t_type == "RECEIPT":
        cursor.execute("""
            UPDATE inventory 
            SET quantity_on_hand = quantity_on_hand + ?,
                last_counted = ?
            WHERE item_id = ? AND location_id = ?
        """, (qty, datetime.now().isoformat(), item_id, location_id))
        
        cursor.execute("""
            INSERT INTO transactions (transaction_type, item_id, to_location_id, quantity, performed_by, notes)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (t_type, item_id, location_id, qty, performed_by, notes))
        
    elif t_type == "FULFILLMENT":
        cursor.execute("""
            UPDATE inventory 
            SET quantity_on_hand = quantity_on_hand - ?
            WHERE item_id = ? AND location_id = ? AND quantity_on_hand >= ?
        """, (qty, item_id, location_id, qty))
        
        if cursor.rowcount == 0:
            print("Insufficient stock or item not found at location.")
            conn.close()
            return
            
        cursor.execute("""
            INSERT INTO transactions (transaction_type, item_id, from_location_id, quantity, performed_by, notes)
            VALUES (?, ?, ?, ?, ?, ?)
        """, (t_type, item_id, location_id, qty, performed_by, notes))
    
    conn.commit()
    print(f"✅ {t_type} of {qty} units for {sku} recorded successfully.")
    conn.close()

def show_dashboard():
    """Simple executive-style dashboard"""
    conn = get_connection()
    cursor = conn.cursor()
    
    print("\n" + "="*80)
    print("INVENTORY OPERATIONS DASHBOARD")
    print("="*80)
    
    # Total SKUs
    cursor.execute("SELECT COUNT(*) FROM items")
    total_skus = cursor.fetchone()[0]
    
    # Total units
    cursor.execute("SELECT SUM(quantity_on_hand) FROM inventory")
    total_units = cursor.fetchone()[0] or 0
    
    # Low stock count
    cursor.execute("""
        SELECT COUNT(*) FROM inventory inv
        JOIN items i ON inv.item_id = i.item_id
        WHERE inv.quantity_on_hand < i.reorder_level
    """)
    low_stock = cursor.fetchone()[0]
    
    print(f"Total Active SKUs:          {total_skus}")
    print(f"Total Units in System:      {total_units:,}")
    print(f"Items Below Reorder Level:  {low_stock}  {' ACTION NEEDED' if low_stock > 0 else ' Good'}")
    
    print("\n--- Recent Transactions (Last 5) ---")
    cursor.execute("""
        SELECT transaction_date, transaction_type, i.sku, quantity, performed_by
        FROM transactions t
        JOIN items i ON t.item_id = i.item_id
        ORDER BY transaction_date DESC
        LIMIT 5
    """)
    
    for row in cursor.fetchall():
        print(f"{row[0][:16]} | {row[1]:<12} | {row[2]:<12} | Qty: {row[3]:>4} | {row[4]}")
    
    conn.close()

def main_menu():
    while True:
        print("\n" + "="*80)
        print("INVENTORY MANAGEMENT SYSTEM - Training & Event Resources")
        print("Business Process Prototype | July 2026")
        print("="*80)
        print("1. View Low Stock / Reorder Report")
        print("2. Record New Transaction (Receipt / Fulfillment / Adjustment)")
        print("3. Show Operations Dashboard")
        print("4. Exit")
        
        choice = input("\nSelect option (1-4): ").strip()
        
        if choice == "1":
            show_low_stock_report()
        elif choice == "2":
            record_transaction()
        elif choice == "3":
            show_dashboard()
        elif choice == "4":
            print("Thank you. Exiting system.")
            sys.exit(0)
        else:
            print("Invalid option. Please try again.")

if __name__ == "__main__":
    if not DB_PATH.exists():
        print("Database not found. Please run the generator script first.")
        sys.exit(1)
    main_menu()
